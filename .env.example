# TikTok Organic MCP Server — Environment Variables
#
# Set up a TikTok Developer app at: https://developers.tiktok.com/
#
# Required scopes: user.info.basic, user.info.profile, user.info.stats, video.list
#
# OAuth flow:
#   1. Create a TikTok Developer app
#   2. Add Login Kit product
#   3. Request the required scopes
#   4. Complete the OAuth authorization flow to get tokens
#   5. See README for detailed instructions

# TikTok OAuth Access Token (obtained via Login Kit OAuth flow)
TIKTOK_ACCESS_TOKEN=your_access_token_here

# TikTok App Client Key (from Developer Portal)
TIKTOK_CLIENT_KEY=your_client_key_here

# TikTok Refresh Token (for token renewal)
TIKTOK_REFRESH_TOKEN=your_refresh_token_here
